---
import Eye from './Eye.astro';
import PixelIcon from './PixelIcon.astro';
import { alternatePath, getCopy, getLocale, siteLinks } from '../i18n';
interface Props { languageAnchors?: Record<string, string>; }
const { languageAnchors = {} } = Astro.props;
const locale = getLocale(Astro.url.pathname);
const copy = getCopy(locale).nav;
const links = siteLinks(locale);
const otherLocale = locale === 'en' ? 'ru' : 'en';
const isDocumentation = Astro.url.pathname.startsWith(links.docs);
---
<header class="site-header">
  <nav class="site-nav" aria-label={copy.label} data-home-url={links.home}>
    <a class="brand flex items-center gap-2.5" href={`${links.home}#top`} aria-label={copy.home}>
      <Eye />
      <span>mdv</span>
    </a>
    <div class="nav-links">
      <a href={`${links.home}?section=features`}>{copy.features}</a>
      <a href={links.docs} aria-current={isDocumentation ? 'true' : undefined} aria-label={copy.docs}><span class="nav-label-wide">{copy.docs}</span><span class="nav-label-short">{copy.docsShort}</span></a>
      <a href={`${links.home}?section=install`}>{copy.install}</a>
    </div>
    <div class="nav-actions">
      <a class="icon-link" href={links.github} aria-label={copy.github} title={copy.github} data-header-icon="github">
        <PixelIcon name="github" />
      </a>
      <a class="icon-link" href={alternatePath(Astro.url.pathname, otherLocale)} lang={otherLocale} hreflang={otherLocale} aria-label={copy.language} title={copy.language} data-header-icon="language" data-language-toggle data-language-anchors={JSON.stringify(languageAnchors)}><PixelIcon name="languages" /></a>
      <button class="motion-toggle icon-link" type="button" aria-label={copy.pause} title={copy.pause} aria-pressed="false" data-header-icon="motion" data-pause-label={copy.pause} data-resume-label={copy.resume}>
        <PixelIcon class="motion-pause" name="pause" />
        <PixelIcon class="motion-play" name="play" />
      </button>
    </div>
  </nav>
</header>
<script>
  import { setupHeaderIconMotion } from '../scripts/header-icon-motion';
  import { setupMotionToggle } from '../scripts/motion-toggle';
  const button = document.querySelector<HTMLButtonElement>('[data-header-icon="motion"]');
  if (button) setupMotionToggle(button);
  setupHeaderIconMotion();
</script>
